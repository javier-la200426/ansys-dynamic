---
batch_connect:
  template: "vnc"
    
script:
  email_on_started: true
  email_on_terminated: true
  email: <%= ENV["USER"] %>@tufts.edu
  job_name: "OnDemand/Paraview"

  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "--ntasks=<%= num_cores %>"
    - "--partition=gpu"
    - "--gres=gpu:1"
