---
batch_connect:
  template: "vnc"

script:
  email_on_started: true
  email_on_terminated: true
  email: <%= ENV["USER"] %>@tufts.edu
  job_name: "OnDemand/Ansys"

  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "-p <%= partition %>"
<%
  skip_gres = gpu_type == "none" || ["batch", "largemem", "rc2", "pangolinlab", "ruiguolab", "shushkovlab", "vaseylab"].include?(partition)
%>
<% unless skip_gres %>
  <% if gpu_type == "any" %>
    - "--gres=gpu:1"
  <% elsif gpu_type.include?("-") %>
    - "--gres=gpu:<%= gpu_type.split('-', 2).first %>:1"
    - "--constraint=<%= gpu_type %>"
  <% else %>
    - "--gres=gpu:<%= gpu_type %>:1"
  <% end %>
<% end %>
