---
<%
  @partition_filter = :gpu
  _partial_path = File.expand_path('partials/gpu_discovery.erb', __dir__)
  ERB.new(File.read(_partial_path)).result(binding)
  _ansys_versions_cmd = "bash -lc 'source /etc/profile.d/lmod.sh >/dev/null 2>&1; module -t avail ansys 2>&1'"
  _ansys_versions = `#{_ansys_versions_cmd}`.scan(/^ansys\/(\S+)/).flatten.uniq.sort.reverse
  _ansys_versions = ["2025R2"] if _ansys_versions.empty?
%>

cluster: "pax"

bc_dynamic_js: true

attributes:
<%= generate_partition_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>

  version:
    widget: "select"
    label: "Ansys version"
    help: "Auto-detected from `module avail ansys`, with a fallback to 2025R2 if discovery is unavailable."
    options:
<% _ansys_versions.each do |v| %>
      - ["<%= v %>", "<%= v %>"]
<% end %>

form:
  - partition
  - bc_num_hours
  - gpu_type
  - num_cores
  - num_memory
  - version
